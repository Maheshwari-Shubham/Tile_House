# ========================================
# TILE HOUSE — Backend Environment Config
# ========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git — it contains secrets!

# === Server ===
PORT=5000
NODE_ENV=development
# For production, use: NODE_ENV=production

# === Database ===
# Local development:
# MONGODB_URI=mongodb://localhost:27017/tilehousedb
#
# MongoDB Atlas (production recommended):
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/tilehousedb?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/tilehousedb

# === Authentication (JWT Secrets) ===
# Generate strong random strings for production!
# Linux/Mac: openssl rand -base64 32
# Windows PowerShell: [Convert]::ToBase64String([System.Security.Cryptography.RNGCryptoServiceProvider]::new().GetBytes(32))
JWT_SECRET=your-secure-admin-jwt-secret-here
USER_JWT_SECRET=your-secure-user-jwt-secret-here

# === Cloudinary Image Upload ===
# Get from: https://cloudinary.com/console/dashboard
# 1. Sign up for free account
# 2. Go to Settings → Upload
# 3. Create unsigned upload preset (mode: Unsigned)
# 4. Copy cloud name and upload preset
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
CLOUDINARY_UPLOAD_PRESET=tile_house_unsigned

# === Email Configuration (for order confirmations) ===
# Render blocks or times out many direct SMTP connections. Use Resend in production.
# Set EMAIL_PROVIDER=resend and use a verified sender/domain in RESEND_FROM.
# Keep EMAIL_PROVIDER=smtp for local Gmail testing.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
RESEND_FROM=
# Gmail: Use App Password (not regular password)
# Get here: https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password-here
EMAIL_FROM_NAME=Tile House

# SMTP transport (Render production)
# Gmail: port 465 with secure=true, or port 587 with secure=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
